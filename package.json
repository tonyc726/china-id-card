{
  "name": "china-id-card",
  "version": "2.1.1",
  "description": "中华人民共和国公民身份号码验证工具库 (GB 11643-1999)",
  "repository": "https://github.com/tonyc726/china-id-card",
  "author": "tonyc726 <zhujf620@gmail.com>",
  "license": "MIT",
  "keywords": [
    "china",
    "id card",
    "id-card",
    "identity",
    "identity-card",
    "validation",
    "validator",
    "GB11643-1999",
    "身份证",
    "身份证号码",
    "身份证验证",
    "身份证脱敏"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.umd.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "lint": "eslint src test --format stylish",
    "format": "prettier --write 'src/**/*.{ts,js}' 'test/**/*.{ts,js}'",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "semantic-release": "npx semantic-release",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "5.0.1",
    "conventional-changelog": "^8.1.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitepress": "^1.6.4",
    "vitest": "5.0.1"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "dist"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run lint && npm run typecheck && npm run typecheck:test"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ],
    "test/**/*.test.ts": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "pnpm": {
    "overrides": {
      "@conventional-changelog/git-client": "^3.1.2",
      "handlebars": "4.7.9",
      "postcss": "8.5.28",
      "ajv@>=7": "8.18.0",
      "js-yaml": "4.3.2",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "ws": "7.5.11",
      "form-data": "3.0.5",
      "flatted": "3.4.4",
      "@tootallnate/once": "2.0.1",
      "@humanfs/node": "0.16.8",
      "rollup": "4.63.5",
      "minimatch@<4": "3.1.3",
      "minimatch@>=4": "9.0.7",
      "picomatch@<4": "2.3.2",
      "picomatch@>=4": "4.0.7",
      "brace-expansion@<2": "1.1.16",
      "brace-expansion@>=2": "2.1.4",
      "undici@<7": "6.28.1",
      "undici@>=7": "7.29.1",
      "vitepress>vite": "6.4.3"
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "singleQuote": true,
    "semi": true,
    "printWidth": 80
  }
}